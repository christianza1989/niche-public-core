{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "memocasting-commerce-mail",
  "account_id": "d102163f74a45ab6d33bca786ce281ec",
  "main": "index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "COMMERCE_MAIL_ENABLED": "1",
    "COMMERCE_ENVIRONMENT": "production",
    "COMMERCE_STORE_ID": "store_memocasting",
    "COMMERCE_TEST_RECIPIENTS": "",
    "SMTP_SENDER_NAME": "Memocasting",
    "COMMERCE_MAIL_TRANSPORT": "hostinger_api"
  },
  "d1_databases": [
    {
      "binding": "COMMERCE_MAIL_DB",
      "database_name": "memocasting-commerce-mail",
      "database_id": "a991978e-2af2-4a53-8950-000e811c30f1",
      "migrations_dir": "migrations"
    }
  ]
}
